{
  "name": "michalosoft/project-classes",
  "description": "Projektová sada tříd pro MiCHALosoft Admin",
  "require": {
    "php": ">=8.3",
    "nette/database": "^3.2",
    "nette/utils": "^4.0",
    "imagine/imagine": "^1.3",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.2"
  },
  "authors": [
    {
      "name": "Michal Diviš",
      "email": "michalosoft@gmail.com",
      "homepage": "https://github.com/inferius"
    }
  ],
  "suggest": {
    "ext-memcache": "Pro použítí cachovaní",
    "latte/latte": "Pro použítí zobrazení šablon",
    "ext-intl": "Pro korektní formátování času"
  },
  "autoload": {
    "classmap": [
      "src/"
    ],
    "files": [
      "src/aliases.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  }
}
